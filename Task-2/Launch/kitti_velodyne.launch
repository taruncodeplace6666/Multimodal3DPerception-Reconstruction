<launch>
    <arg name="rviz" default="true" />

    <!-- Load main config -->
    <rosparam command="load"
              file="$(find fast_livo)/config/kitti_velodyne.yaml"/>

    <!-- Load camera intrinsics -->
    <rosparam command="load"
              file="$(find fast_livo)/config/camera_kitti.yaml"
              ns="laserMapping"/>

    <!-- Step 1: Point cloud fixer — adds ring + time fields -->
    <!-- Subscribes: /kitti/velo/pointcloud  (raw, no ring/time) -->
    <!-- Publishes:  /kitti/velo/pointcloud_fixed (with ring+time) -->
    <node pkg="fast_livo"
          type="kitti_cloud_fixer.py"
          name="kitti_cloud_fixer"
          output="screen"/>

    <!-- Step 2: FAST-LIVO2 — remapped to consume the FIXED cloud -->
    <node pkg="fast_livo"
          type="fastlivo_mapping"
          name="laserMapping"
          output="screen">
        <remap from="/livox/lidar" to="/kitti/velo/pointcloud_fixed" />
        <remap from="/livox/imu"   to="/kitti/oxts/imu" />
    </node>

    <group if="$(arg rviz)">
        <node pkg="rviz"
              type="rviz"
              name="rviz"
              args="-d $(find fast_livo)/rviz_cfg/fast_livo.rviz"/>
    </group>
</launch>

